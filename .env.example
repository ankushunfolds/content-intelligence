# ---------------------------------------------------------------------------
# Content Intelligence — copy to .env and fill in what you have.
# Everything below has a working default. The app runs with an empty .env.
# ---------------------------------------------------------------------------

APP_ENV=development
SECRET_KEY=change-me-in-production

# Postgres in production. Leave as-is to use a local SQLite file instead.
# For Postgres: pip install -r backend/requirements-optional.txt, then swap these.
DATABASE_URL=sqlite:///./content_intelligence.db
# DATABASE_URL=postgresql+psycopg://ci:ci@localhost:5432/content_intelligence

REDIS_URL=redis://localhost:6379/0

# --- YouTube -----------------------------------------------------------------
# "mock" = deterministic seed data, no key needed.
# "youtube" = real YouTube Data API v3 (requires YOUTUBE_API_KEY).
YOUTUBE_PROVIDER=mock
YOUTUBE_API_KEY=
VIDEOS_PER_CHANNEL=30

# --- LLM ---------------------------------------------------------------------
# "mock" | "openai" | "gemini". Falls back to mock automatically if the key is missing.
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
# Pin exact versions, never aliases like gemini-flash-latest: an alias that
# re-points under you is the same silent-degradation failure as a model that
# retires under you. Retired names are listed in services/llm.py and warn loudly.
# Classification is high-volume constrained labelling -> the cheap Lite model.
# Briefs are user-facing prose -> the better model. Output tokens cost 5-8x
# input, and briefs are ~1 call/user/day, so this split is most of the savings.
LLM_CLASSIFY_MODEL=gemini-3.5-flash-lite
LLM_BRIEF_MODEL=gemini-3.5-flash

# Gemini 3.x thinking tokens bill at the OUTPUT rate. 0 disables, -1 lets the
# model decide. Leave BLANK to send no thinking config at all — which is what
# you want on the Lite models: they don't reason, and they reject the field
# with a 400 if it's present. Only set these when pointing classification at a
# model that actually thinks.
LLM_CLASSIFY_THINKING_BUDGET=
LLM_BRIEF_THINKING_BUDGET=

# Retries for transient provider failures (429 / 5xx / connection errors)
# before degrading to mock output. 2 retries = 3 attempts, ~1s then ~2s.
# Deliberately low: briefs are one call and worth a short wait, but a pipeline
# run classifies many batches, and a real outage should fall back promptly
# rather than sleep its way through every batch.
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=1.0

# --- Intelligence tuning -----------------------------------------------------
BREAKOUT_THRESHOLD=3.0
TREND_WINDOW_DAYS=7
MIN_VIDEOS_FOR_TREND=3
MAX_BRIEF_OPPORTUNITIES=5
MAX_BRIEF_HIGHLIGHTS=3
MAX_BRIEF_TRENDS=5
MAX_COMPETITORS=10

CORS_ORIGINS=http://localhost:3000

# --- Admin ---------------------------------------------------------------
# Comma-separated. Emails here get admin access (GET /admin/events, /admin/stats)
# the moment they sign up. Empty by default — /admin/* returns 403 for everyone
# until you opt an account in.
ADMIN_EMAILS=
