# ---------------------------------------------------------------------------
# Content Intelligence — copy to .env and fill in what you have.
# Everything below has a working default. The app runs with an empty .env.
# ---------------------------------------------------------------------------

APP_ENV=development
SECRET_KEY=change-me-in-production

# Postgres in production. Leave as-is to use a local SQLite file instead.
# For Postgres: pip install -r backend/requirements-optional.txt, then swap these.
DATABASE_URL=sqlite:///./content_intelligence.db
# DATABASE_URL=postgresql+psycopg://ci:ci@localhost:5432/content_intelligence

REDIS_URL=redis://localhost:6379/0

# --- YouTube -----------------------------------------------------------------
# "mock" = deterministic seed data, no key needed.
# "youtube" = real YouTube Data API v3 (requires YOUTUBE_API_KEY).
YOUTUBE_PROVIDER=mock
YOUTUBE_API_KEY=
VIDEOS_PER_CHANNEL=30

# --- LLM ---------------------------------------------------------------------
# "mock" | "openai" | "gemini". Falls back to mock automatically if the key is missing.
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_CLASSIFY_MODEL=gpt-4o-mini
LLM_BRIEF_MODEL=gpt-4o-mini

# --- Intelligence tuning -----------------------------------------------------
BREAKOUT_THRESHOLD=3.0
TREND_WINDOW_DAYS=7
MIN_VIDEOS_FOR_TREND=3
MAX_BRIEF_OPPORTUNITIES=5
MAX_BRIEF_HIGHLIGHTS=3
MAX_BRIEF_TRENDS=5
MAX_COMPETITORS=10

CORS_ORIGINS=http://localhost:3000

# --- Admin ---------------------------------------------------------------
# Comma-separated. Emails here get admin access (GET /admin/events, /admin/stats)
# the moment they sign up. Empty by default — /admin/* returns 403 for everyone
# until you opt an account in.
ADMIN_EMAILS=
